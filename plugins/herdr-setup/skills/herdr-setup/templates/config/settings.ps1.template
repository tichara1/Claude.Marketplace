# Generated by the herdr-setup skill. Safe to edit by hand.
#
# This file is dot-sourced by lib.ps1, so every script picks changes up on its next
# run. Two exceptions read their values only at daemon start:
#   $global:StatusInterval, $global:FetchIntervalSeconds
# After changing those, restart the status daemon.

$global:PluginId        = '{{PLUGIN_ID}}'

# --- worktrees ---------------------------------------------------------------
$global:WorktreePrefix  = '{{WORKTREE_PREFIX}}'

# --- agent -------------------------------------------------------------------
$global:AgentKind       = '{{AGENT_KIND}}'
$global:AgentArgs       = @({{AGENT_ARGS}})
$global:AgentAutostart  = ${{AGENT_AUTOSTART}}

# Untracked files copied from the main checkout into a fresh worktree. These are
# FILE NAMES, not glob patterns - they are matched recursively, skipping
# bin/obj/node_modules/.git.
$global:BootstrapCopy   = @({{BOOTSTRAP_COPY}})

# Run in the side pane after a worktree is created. Empty disables.
$global:WorktreeSetupCommand = '{{WORKTREE_SETUP_COMMAND}}'

# {branch} and {path} are substituted.
$global:WorktreePrompt  = '{{WORKTREE_PROMPT}}'

# --- sidebar daemon (restart the daemon after changing these) ----------------
$global:StatusInterval       = {{STATUS_INTERVAL}}
$global:FetchIntervalSeconds = {{FETCH_INTERVAL}}   # 0 disables auto-fetch
$global:FetchTimeoutMs       = 30000

# --- editors -----------------------------------------------------------------
$global:PrimaryEditor   = '{{PRIMARY_EDITOR}}'
$global:SecondaryEditor = '{{SECONDARY_EDITOR}}'

# --- prompts -----------------------------------------------------------------
$global:ReviewPrompt    = '{{REVIEW_PROMPT}}'
$global:SendFilesPrompt = '{{SEND_FILES_PROMPT}}'
