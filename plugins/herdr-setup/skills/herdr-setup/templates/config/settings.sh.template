#!/usr/bin/env bash
# Generated by the herdr-setup skill. Safe to edit by hand.
#
# This file is sourced by lib.sh, so every script picks changes up on its next run.
# Two exceptions read their values only at daemon start:
#   STATUS_INTERVAL, FETCH_INTERVAL_SECONDS
# After changing those, restart the status daemon.

PLUGIN_ID='{{PLUGIN_ID}}'

# --- worktrees ---------------------------------------------------------------
WORKTREE_PREFIX='{{WORKTREE_PREFIX}}'

# --- agent -------------------------------------------------------------------
AGENT_KIND='{{AGENT_KIND}}'
# Word-split on purpose when passed after `--`.
AGENT_ARGS='{{AGENT_ARGS}}'
AGENT_AUTOSTART={{AGENT_AUTOSTART}}   # 1 or 0

# Untracked files copied from the main checkout into a fresh worktree. These are
# FILE NAMES, not glob patterns - matched recursively, skipping
# bin/obj/node_modules/.git. Space separated.
BOOTSTRAP_COPY='{{BOOTSTRAP_COPY}}'

# Run in the side pane after a worktree is created. Empty disables.
WORKTREE_SETUP_COMMAND='{{WORKTREE_SETUP_COMMAND}}'

# {branch} and {path} are substituted.
WORKTREE_PROMPT='{{WORKTREE_PROMPT}}'

# --- sidebar daemon (restart the daemon after changing these) ----------------
STATUS_INTERVAL={{STATUS_INTERVAL}}
FETCH_INTERVAL_SECONDS={{FETCH_INTERVAL}}   # 0 disables auto-fetch
FETCH_TIMEOUT_MS=30000

# --- editors -----------------------------------------------------------------
PRIMARY_EDITOR='{{PRIMARY_EDITOR}}'
SECONDARY_EDITOR='{{SECONDARY_EDITOR}}'

# --- prompts -----------------------------------------------------------------
REVIEW_PROMPT='{{REVIEW_PROMPT}}'
SEND_FILES_PROMPT='{{SEND_FILES_PROMPT}}'
