# Shell scripts MUST keep LF. A CRLF checkout makes them unrunnable on macOS and
# Linux - the shebang line ends up as "#!/usr/bin/env bash\r" and the loader reports
# "bad interpreter". This is checked out on Windows too, where git would otherwise
# convert them.
*.sh text eol=lf

# Batch files are the mirror image: cmd.exe fails to parse `if (...)` blocks when the
# file has LF endings.
*.cmd text eol=crlf
*.bat text eol=crlf

# Everything else: normalise in the repo, let git pick the working-copy ending.
*.ps1  text
*.md   text
*.toml text
*.json text
